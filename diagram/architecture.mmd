%% Component architecture. Solid arrows show calls or data flow; dotted lines show support.
flowchart TB
    user([Developer / task])

    subgraph entry["FRONT ENDS AND COMPOSITION · §12–§16"]
        direction LR
        cli["Interactive app · mak run<br/>cli/ · mak/__main__.py"]
        app["Application API<br/>mak/application/<br/>RunRequest · build_config · PlannerRoute<br/>planner key · build_session"]
        boot["Composition root<br/>mak/bootstrap.py · mak/config.py<br/>Adapter registry · health preflight"]
        catalog["Model catalog + local discovery<br/>mak/models/ · mak/local/"]
        endpoints["Endpoints<br/>mak/endpoints/<br/>Profiles · credentials by name<br/>structured-output ladder"]
        cli -->|same RunRequest from both| app
        app --> boot
        catalog -. model choice + capability seed .-> boot
        endpoints -. endpoint + capability cache .-> boot
    end

    subgraph kernel["MAK KERNEL · one Python process"]
        session["Session state machine · §11<br/>mak/session/<br/>Lifecycle · run loop · WaveState<br/>spend ceiling · heartbeat + watchdog"]
        planner["Planner · §9<br/>mak/planner/<br/>Inventory view · retrieval rounds<br/>validation · caller tasks · review"]
        scheduler["Scheduler + lock policy · §6<br/>mak/scheduler/<br/>DAG · atomic lock pre-allocation"]
        locks["Lock manager · §4<br/>mak/lock_manager/<br/>RW + intent locks · #api / key resources<br/>project lease"]
        dispatch["Dispatch enrichment · §3.3<br/>mak/session/dispatch.py<br/>Context layers 0–5 · read-set capture"]
        runner["Agent runner + adapters · §7<br/>mak/agent_runner/<br/>TaskBundle → TaskResult<br/>stop signals · repair turn"]
        pipeline["Commit pipeline · §5.3<br/>mak/session/commit/<br/>Nine ordered checks → one verdict"]
        semantic["Semantic layer · §5.3<br/>mak/semantic/<br/>Read sets · contracts · registrar merge<br/>cascade graph · optional gates"]
        detector["Structural + wave-end checks · §5.1–5.2<br/>mak/conflict_detector/"]
        store[("Versioned AST node store · §2<br/>mak/node_store/<br/>Committed + staged fragments")]
        txn["Transaction + journal · §3.5<br/>mak/node_store/<br/>Render · compile · atomic install"]
        cascade["Cascade loop · §11<br/>mak/cascade.py<br/>Fix-up waves · repair obligations<br/>stall / oscillation stop"]
        teardown["Teardown + outcome · §11<br/>mak/teardown.py · mak/execution_result.py<br/>Test policy · push gate"]
        core["Shared types · exceptions · event log · §1<br/>mak/core/"]

        session -->|propose / install plan| planner
        planner -->|validated SubTask DAG| scheduler
        scheduler -->|try_acquire_all| locks
        scheduler -->|ready tasks| dispatch
        store -->|targets + read context| dispatch
        dispatch -->|enriched bundle| runner
        runner -->|TaskResult| pipeline
        pipeline --> semantic
        pipeline --> detector
        pipeline -->|stage / commit / roll back| store
        store -->|accepted versions| txn
        session -->|wave end| cascade
        cascade -->|fix-up plan| planner
        cascade --> semantic
        session --> teardown
        session -. shared support .-> core
    end

    subgraph backends["AGENT AND PLANNER BACKENDS"]
        hosted["Hosted APIs<br/>Anthropic · OpenAI · Gemini"]
        compat["OpenAI-compatible endpoints<br/>OpenRouter · NVIDIA · DeepSeek · Z.ai · custom"]
        local["Local runtimes<br/>Native Ollama · OpenAI-compatible server"]
        subprocess["Agent CLI subprocesses<br/>Claude Code · Codex · Copilot<br/>optional Docker sandbox"]
    end

    subgraph project["ONE SHARED PROJECT DIRECTORY"]
        files["Python source files<br/>Ingested at startup · reconstructed after commits"]
        state[(".mak/ runtime state<br/>Node versions · journal · lock table<br/>lease · task graph · session log")]
        git["Git audit history · §10<br/>mak/git_integration/<br/>Per-task [MAK-id] commits · gated push"]
    end

    user --> cli
    boot -->|wired session| session
    runner --> hosted & compat & local & subprocess
    planner -. planning calls .-> hosted & compat & local
    txn -->|derived output| files
    session -. persistence / recovery .-> state
    txn -->|after the commit point| git
    teardown -->|push only if satisfied and tests pass| git

    classDef entry_style fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
